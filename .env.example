# Copy to backend/.env (or project root .env) and fill in from Auth0.

SECRET_KEY=change-me
JWT_SECRET_KEY=change-me-too

# Auth0 Application (Single Page Application)
# Dashboard → Applications → Your SPA → Settings
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_CLIENT_ID=your_spa_client_id

# Optional — only needed if you also protect APIs with Auth0 access tokens
# AUTH0_AUDIENCE=https://loyable-api
